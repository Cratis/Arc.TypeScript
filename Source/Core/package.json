{
  "name": "@cratis/arc.core",
  "version": "0.37.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Schema-backed CQRS command and query pipelines for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cratis/Arc.TypeScript.git",
    "directory": "Source/Core"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js"
    },
    "./hosting": {
      "types": "./dist/hosting.d.ts",
      "import": "./dist/hosting.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@cratis/arc.testing": "workspace:^",
    "@cratis/fundamentals": "7.19.6",
    "@opentelemetry/api": "^1.9.0",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@cratis/fundamentals": "^7.19.6",
    "@opentelemetry/api": "^1.9.0",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": true
    }
  },
  "dependencies": {
    "jose": "^6.1.0",
    "ws": "^8.21.3",
    "zod": "^4.1.0"
  }
}
