{
  "name": "@cratis/arc.server.codegen",
  "version": "0.3.0",
  "description": "Deterministic manifest-based TypeScript clients for Arc Server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cratis/Arc.TypeScript.git",
    "directory": "CodeGeneration"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "arc-server-codegen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "@cratis/arc.server": "workspace:^"
  },
  "scripts": {
    "build": "tsc -b"
  }
}
