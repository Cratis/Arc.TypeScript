{
  "name": "arc-typescript-workspace",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "Source",
    "Integrations/*",
    "Samples/*",
    "ContractTests/Http",
    "ContractTests/Client",
    "CodeGeneration"
  ],
  "scripts": {
    "lint": "eslint Source Integrations Samples CodeGeneration",
    "docs:lint": "markdownlint-cli2",
    "test:client-generation": "yarn build && yarn test:client-generation:verify",
    "test:client-generation:verify": "yarn tsc -p ContractTests/Client/tsconfig.json && node --test ContractTests/Client/*.test.mjs",
    "test:conformance": "dotnet restore ContractTests/DotNET/HttpFixture.csproj --locked-mode && dotnet build ContractTests/DotNET/HttpFixture.csproj -c Debug --no-restore && yarn build && node --test ContractTests/Http/conformance.test.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.specs.json",
    "build": "tsc -b",
    "specs": "vitest run",
    "ci": "yarn lint && yarn typecheck && yarn build && yarn test:client-generation:verify && yarn specs && yarn docs:lint && node --test scripts/for_release/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "markdownlint-cli2": "^0.20.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
